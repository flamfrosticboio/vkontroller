{
  "$schema": "https://biomejs.dev/schemas/2.4.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "src/**/*.js",
      "test/**/*.js",
      "!**/*.min.js",
      "src/**/*.ts",
      "src/**/*.tsx"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "formatWithErrors": true,
    "lineWidth": 80,
    "lineEnding": "lf",
    "indentWidth": 2,
    "attributePosition": "multiline",
    "bracketSpacing": true,
    "expand": "auto",
    "trailingNewline": true
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        "useNamingConvention": {
          "level": "error",
          "options": {
            "strictCase": true,
            "requireAscii": true
          }
        }
      }
    },
    "includes": ["**", "!test/**"]
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    },
    "parser": {
      "jsxEverywhere": false
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              [":BUN:", ":NODE:"],
              ":BLANK_LINE:",
              ":PACKAGE:",
              ":BLANK_LINE",
              { "type": false, "source": [":ALIAS:", ":PATH:"] },
              {
                "type": true,
                "source": [":ALIAS:", ":PATH:"]
              }
            ],
            "identifierOrder": "lexicographic"
          }
        }
      }
    }
  }
}
